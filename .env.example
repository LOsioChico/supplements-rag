# Required — judge, writer, and gate calls hit the vllm-sr router.
VLLM_SR_API_KEY=

# Optional — NCBI API key raises the E-utilities limit from 3 to 10 req/s.
# Register free at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Optional overrides (defaults shown — leave unset to use them):
# VLLM_SR_BASE=https://app.vllm-sr.ai   # router endpoint (generate, judge)
# WRITER_MODEL=vllm-sr/auto            # writer model on the router
# EXTRACTIVE=1                         # 0 opts back into the writer lane
# SR_PORT=8778                         # local exhibit server port
# DENSE_URL=http://127.0.0.1:8779     # dense sidecar (serve.py spawns it)
# MODEL_PRICES={...}                  # USD/1M table override — built-in defaults
#                                     # use the upstream providers' published
#                                     # rates; vllm-sr/* calls stay unpriced
